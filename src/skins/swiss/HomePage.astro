---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../lib/i18n';
import type { UIStrings } from '../../i18n';
import type { ExperienceEntry, EducationEntry } from '../../data/profile';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';
import ExperienceRow from './ExperienceRow.astro';
import EducationRow from './EducationRow.astro';

interface Props {
  locale: Locale;
  t: UIStrings;
  featuredProjects: CollectionEntry<'projects'>[];
  recentPosts: CollectionEntry<'posts'>[];
  experience: ExperienceEntry[];
  education: EducationEntry[];
  skills: { languages: string[]; ml: string[]; infra: string[] };
}

const { locale, t, featuredProjects, recentPosts, experience, education, skills } = Astro.props;

const skillGroups = [
  { label: t.home.skillsLanguages, items: skills.languages },
  { label: t.home.skillsMl, items: skills.ml },
  { label: t.home.skillsInfra, items: skills.infra },
];
---

<section class="hero">
  <div class="hero__intro">
    <div class="swiss-eyebrow">★ {t.home.heroEyebrow}</div>
    <h1 class="hero__heading">{t.home.heroGreeting}<br />{t.home.heroName}.</h1>
  </div>
  <div class="hero__side">
    <p class="hero__lead">{t.home.heroLead}</p>
    <div class="hero__actions">
      <a href={getRelativeLocaleUrl(locale, 'projects')} class="swiss-button swiss-button--filled">{t.home.viewProjects}</a>
      <a href="/cv.pdf" class="swiss-button">{t.home.downloadCv}</a>
    </div>
    <div class="hero__links">
      <a href="https://github.com/ayberk-kara" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/ayberk-kara" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</section>

<section class="swiss-shell swiss-section">
  <div class="swiss-section__head">
    <h2 class="swiss-section__heading">{t.home.projectsHeading}</h2>
    <a href={getRelativeLocaleUrl(locale, 'projects')} class="swiss-section__link">{t.home.projectsViewAll} →</a>
  </div>
  <div class="swiss-grid-3">
    {featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)}
  </div>
</section>

<section class="swiss-shell swiss-section">
  <div class="swiss-section__head">
    <h2 class="swiss-section__heading">{t.home.skillsHeading}</h2>
  </div>
  <div class="swiss-skills-grid">
    {
      skillGroups.map((group) => (
        <div class="skills__group">
          <div class="skills__label">{group.label}</div>
          <div class="skills__items">
            {group.items.map((item) => <span class="swiss-tag">{item}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="swiss-shell swiss-section">
  <div class="swiss-grid-2">
    <div class="swiss-section__head">
      <h2 class="swiss-section__heading">{t.home.experienceHeading}</h2>
      <div class="swiss-filter" data-filter-group data-filter-target="experience-list-swiss" aria-label={t.home.experienceFilterAriaLabel}>
        <button type="button" data-filter-value="all" aria-pressed="true">{t.home.experienceFilterAll}</button>
        <button type="button" data-filter-value="eng" aria-pressed="false">{t.home.experienceFilterEng}</button>
      </div>
    </div>
    <div class="swiss-section__head">
      <h2 class="swiss-section__heading">{t.home.educationHeading}</h2>
    </div>
  </div>
  <div class="swiss-grid-2">
    <div id="experience-list-swiss" data-filter-list>
      {experience.map((entry) => <ExperienceRow {...entry} />)}
    </div>
    <div>
      {education.map((entry) => <EducationRow {...entry} />)}
    </div>
  </div>
</section>

<section class="swiss-shell swiss-section">
  <div class="swiss-grid-2">
    <div>
      <div class="swiss-section__head">
        <h2 class="swiss-section__heading">{t.home.blogHeading}</h2>
        <a href={getRelativeLocaleUrl(locale, 'blog')} class="swiss-section__link">{t.home.blogAllPosts} →</a>
      </div>
      {recentPosts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
    <div id="contact">
      <div class="swiss-section__head">
        <h2 class="swiss-section__heading">{t.home.contactHeading}</h2>
      </div>
      <form
        class="contact-form"
        data-contact-form
        data-sending-text={t.home.contactSending}
        data-success-text={t.home.contactSuccess}
        data-error-text={t.home.contactError}
      >
        <input type="text" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="contact-name">{t.home.contactNameLabel}</label>
        <input id="contact-name" type="text" name="name" placeholder={t.home.contactName} required />
        <label class="sr-only" for="contact-email">{t.home.contactEmailLabel}</label>
        <input id="contact-email" type="email" name="email" placeholder={t.home.contactEmail} required />
        <label class="sr-only" for="contact-subject">{t.home.contactSubjectLabel}</label>
        <input id="contact-subject" type="text" name="subject" placeholder={t.home.contactSubject} />
        <label class="sr-only" for="contact-message">{t.home.contactMessageLabel}</label>
        <textarea id="contact-message" name="message" rows="3" placeholder={t.home.contactMessage} required></textarea>
        <button type="submit" class="swiss-button swiss-button--accent">{t.home.contactSend}</button>
        <p class="contact-form__status" data-contact-status></p>
      </form>
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: var(--swiss-max-width);
    margin: 0 auto;
    padding: 0 var(--swiss-gutter) 40px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 54px;
    align-items: end;
    border-bottom: 2px solid var(--swiss-border-strong);
  }

  .hero__heading {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 6px;
  }

  .hero__lead {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--swiss-muted);
    margin: 0;
  }

  .hero__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero__links {
    display: flex;
    gap: 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__links a {
    text-decoration: none;
    border-bottom: 2px solid var(--swiss-accent);
    padding-bottom: 2px;
  }

  .skills__label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .skills__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-form input,
  .contact-form textarea {
    border: 1px solid var(--swiss-border);
    background: var(--swiss-bg);
    color: var(--swiss-text);
    padding: 11px 13px;
    font-size: 13px;
    font-family: inherit;
    outline: none;
    resize: none;
  }

  .contact-form__status {
    margin: 0;
    font-size: 12px;
    font-family: var(--swiss-font-mono);
  }

  .contact-form__status[data-state='success'] {
    color: #3c6e47;
  }

  .contact-form__status[data-state='error'] {
    color: var(--swiss-accent);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }
  }
</style>
