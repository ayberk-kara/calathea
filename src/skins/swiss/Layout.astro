---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';
import { skinList } from '../../config/skin-list';

interface Props {
  skinId: string;
  active: 'home' | 'projects' | 'blog' | null;
  locale: Locale;
}

const { skinId, active, locale } = Astro.props;
const t = getUI(locale);

const homeHref = getRelativeLocaleUrl(locale);

const navItems = [
  { key: 'projects', href: getRelativeLocaleUrl(locale, 'projects'), label: t.nav.projects },
  { key: 'blog', href: getRelativeLocaleUrl(locale, 'blog'), label: t.nav.blog },
  { key: 'contact', href: `${homeHref}#contact`, label: t.nav.contact },
] as const;

const path = Astro.url.pathname.replace(/^\/(en|tr)\/?/, '').replace(/\/$/, '');
const localeHrefs: Record<Locale, string> = {
  en: path ? getRelativeLocaleUrl('en', path) : getRelativeLocaleUrl('en'),
  tr: path ? getRelativeLocaleUrl('tr', path) : getRelativeLocaleUrl('tr'),
};

const year = new Date().getFullYear();
---

<div data-skin-root={skinId}>
  <header class="swiss-header">
    <div class="swiss-shell swiss-header__inner">
      <a href={homeHref} class="swiss-header__logo">AK</a>

      <nav class="swiss-header__links" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="swiss-header__actions">
        <div class="swiss-locale" role="group" aria-label={t.nav.languageLabel}>
          <a href={localeHrefs.en} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          <a href={localeHrefs.tr} aria-current={locale === 'tr' ? 'true' : undefined}>TR</a>
        </div>

        {
          skinList.length > 1 && (
            <div class="swiss-skin-picker">
              <label class="sr-only" for={`skin-select-${skinId}`}>Skin</label>
              <select id={`skin-select-${skinId}`} data-skin-select aria-label="Skin">
                {skinList.map((skin) => (
                  <option value={skin.id}>{skin.label}</option>
                ))}
              </select>
            </div>
          )
        }

        <button class="swiss-icon-btn" type="button" data-mode-toggle aria-label={t.nav.themeToggle}>
          <svg class="swiss-icon swiss-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.5 5.5l-2 2M7.5 16.5l-2 2M18.5 18.5l-2-2M7.5 7.5l-2-2"></path>
          </svg>
          <svg class="swiss-icon swiss-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"></path>
          </svg>
        </button>

        <button
          class="swiss-icon-btn swiss-burger"
          type="button"
          data-nav-toggle
          aria-label={t.nav.menuToggle}
          aria-expanded="false"
          aria-controls={`mobile-nav-${skinId}`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav id={`mobile-nav-${skinId}`} class="swiss-mobile-nav" aria-label="Primary mobile">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="swiss-main">
    <slot />
  </main>

  <footer class="swiss-footer">
    <div class="swiss-shell swiss-footer__inner">
      <span>{t.footer.copy(year)}</span>
    </div>
  </footer>
</div>

<style>
  .swiss-header {
    border-bottom: 2px solid var(--swiss-border-strong);
  }

  .swiss-header__inner {
    height: 72px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .swiss-header__logo {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-decoration: none;
    flex: 0 0 auto;
  }

  .swiss-header__links {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-right: auto;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .swiss-header__links a {
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }

  .swiss-header__links a[aria-current='page'] {
    border-bottom-color: var(--swiss-accent);
  }

  .swiss-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .swiss-locale {
    display: inline-flex;
    border: 1.5px solid var(--swiss-border-strong);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .swiss-locale a {
    padding: 6px 10px;
    text-decoration: none;
  }

  .swiss-locale a[aria-current='true'] {
    background: var(--swiss-border-strong);
    color: var(--swiss-bg);
  }

  .swiss-skin-picker select {
    height: 36px;
    border: 1.5px solid var(--swiss-border-strong);
    background: var(--swiss-bg);
    color: var(--swiss-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0 8px;
    cursor: pointer;
  }

  .swiss-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--swiss-border-strong);
    background: var(--swiss-bg);
    color: var(--swiss-text);
    cursor: pointer;
    padding: 0;
  }

  .swiss-icon {
    width: 16px;
    height: 16px;
  }

  .swiss-burger {
    display: none;
  }

  .swiss-burger svg {
    width: 16px;
    height: 16px;
  }

  .swiss-mobile-nav {
    display: none;
    flex-direction: column;
    border-top: 1.5px solid var(--swiss-border-strong);
    padding: 8px var(--swiss-gutter);
  }

  .swiss-mobile-nav a {
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 0;
    border-bottom: 1px solid var(--swiss-border);
  }

  .swiss-mobile-nav a:last-child {
    border-bottom: none;
  }

  .swiss-mobile-nav a[aria-current='page'] {
    color: var(--swiss-accent);
  }

  .swiss-mobile-nav.is-open {
    display: flex;
  }

  @media (max-width: 880px) {
    .swiss-header__links {
      display: none;
    }

    .swiss-burger {
      display: inline-flex;
    }
  }

  .swiss-main {
    flex: 1;
    padding: 76px 0 130px;
  }

  .swiss-footer {
    border-top: 2px solid var(--swiss-border-strong);
  }

  .swiss-footer__inner {
    height: 64px;
    display: flex;
    align-items: center;
    font-size: 12px;
    color: var(--swiss-faint);
    font-family: var(--swiss-font-mono);
  }
</style>
