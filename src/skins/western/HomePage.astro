---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../lib/i18n';
import type { UIStrings } from '../../i18n';
import type { ExperienceEntry, EducationEntry } from '../../data/profile';
import ProjectCard from './ProjectCard.astro';
import PostCard from './PostCard.astro';
import ExperienceRow from './ExperienceRow.astro';
import EducationRow from './EducationRow.astro';

interface Props {
  locale: Locale;
  t: UIStrings;
  featuredProjects: CollectionEntry<'projects'>[];
  recentPosts: CollectionEntry<'posts'>[];
  experience: ExperienceEntry[];
  education: EducationEntry[];
  skills: { languages: string[]; ml: string[]; infra: string[] };
}

const { locale, t, featuredProjects, recentPosts, experience, education, skills } = Astro.props;

const skillGroups = [
  { label: t.home.skillsLanguages, items: skills.languages },
  { label: t.home.skillsMl, items: skills.ml },
  { label: t.home.skillsInfra, items: skills.infra },
];
---

<section class="western-shell hero">
  <div class="hero__intro">
    <div class="western-eyebrow">★ {t.home.heroEyebrow}</div>
    <h1 class="hero__heading">{t.home.heroGreeting}<br />{t.home.heroName}.</h1>
  </div>
  <div class="hero__side">
    <p class="hero__lead">{t.home.heroLead}</p>
    <div class="hero__actions">
      <a href={getRelativeLocaleUrl(locale, 'projects')} class="western-button western-button--filled">{t.home.viewProjects}</a>
      <a href="/cv.pdf" class="western-button">{t.home.downloadCv}</a>
    </div>
    <div class="hero__links">
      <a href="https://github.com/ayberk-kara" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/ayberk-kara" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</section>

<section class="western-shell western-section">
  <div class="western-section__head">
    <h2 class="western-section__title">{t.home.projectsHeading}</h2>
    <a href={getRelativeLocaleUrl(locale, 'projects')} class="western-section__link">{t.home.projectsViewAll} →</a>
  </div>
  <div class="western-grid-3">
    {featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)}
  </div>
</section>

<section class="western-shell western-section">
  <div class="western-section__head">
    <h2 class="western-section__title">{t.home.skillsHeading}</h2>
  </div>
  <div class="western-grid-3">
    {
      skillGroups.map((group) => (
        <div class="western-card skills__group">
          <div class="skills__label">{group.label}</div>
          <div class="skills__items">
            {group.items.map((item) => <span class="western-tag">{item}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="western-shell western-section">
  <div class="western-grid-2">
    <div class="western-section__head">
      <h2 class="western-section__title">{t.home.experienceHeading}</h2>
      <div class="western-filter" data-filter-group data-filter-target="experience-list" aria-label={t.home.experienceFilterAriaLabel}>
        <button type="button" data-filter-value="all" aria-pressed="true">{t.home.experienceFilterAll}</button>
        <button type="button" data-filter-value="eng" aria-pressed="false">{t.home.experienceFilterEng}</button>
      </div>
    </div>
    <div class="western-section__head">
      <h2 class="western-section__title">{t.home.educationHeading}</h2>
    </div>
  </div>
  <div class="western-grid-2">
    <div id="experience-list" data-filter-list class="row-list">
      {experience.map((entry) => <ExperienceRow {...entry} />)}
    </div>
    <div class="row-list">
      {education.map((entry) => <EducationRow {...entry} />)}
    </div>
  </div>
</section>

<section class="western-shell western-section">
  <div class="western-grid-2">
    <div>
      <div class="western-section__head">
        <h2 class="western-section__title">{t.home.blogHeading}</h2>
        <a href={getRelativeLocaleUrl(locale, 'blog')} class="western-section__link">{t.home.blogAllPosts} →</a>
      </div>
      <div class="blog-feed">
        {recentPosts.map((post) => <PostCard post={post} locale={locale} />)}
      </div>
    </div>
    <div id="contact">
      <div class="western-section__head">
        <h2 class="western-section__title">{t.home.contactHeading}</h2>
      </div>
      <form
        class="western-card contact-form"
        data-contact-form
        data-sending-text={t.home.contactSending}
        data-success-text={t.home.contactSuccess}
        data-error-text={t.home.contactError}
      >
        <input type="text" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
        <div class="contact-form__row">
          <div>
            <label class="sr-only" for="contact-name">{t.home.contactNameLabel}</label>
            <input id="contact-name" type="text" name="name" placeholder={t.home.contactName} required />
          </div>
          <div>
            <label class="sr-only" for="contact-email">{t.home.contactEmailLabel}</label>
            <input id="contact-email" type="email" name="email" placeholder={t.home.contactEmail} required />
          </div>
        </div>
        <label class="sr-only" for="contact-subject">{t.home.contactSubjectLabel}</label>
        <input id="contact-subject" type="text" name="subject" placeholder={t.home.contactSubject} />
        <label class="sr-only" for="contact-message">{t.home.contactMessageLabel}</label>
        <textarea id="contact-message" name="message" rows="4" placeholder={t.home.contactMessage} required></textarea>
        <div class="contact-form__footer">
          <p class="contact-form__status" data-contact-status></p>
          <button type="submit" class="western-button western-button--accent">{t.home.contactSend}</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 8px;
    padding-bottom: 48px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: end;
    border-bottom: 2.5px solid var(--western-border-strong);
  }

  .hero__heading {
    font-family: var(--western-font-display);
    font-weight: 400;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 6px;
  }

  .hero__lead {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--western-muted);
    margin: 0;
  }

  .hero__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero__links {
    display: flex;
    gap: 22px;
    font-family: var(--western-font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero__links a {
    text-decoration: none;
    border-bottom: 2px solid var(--western-accent);
    padding-bottom: 2px;
  }

  .skills__label {
    font-family: var(--western-font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--western-accent-2);
  }

  .skills__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .row-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .blog-feed {
    display: flex;
    flex-direction: column;
  }

  .contact-form {
    gap: 12px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 2px solid var(--western-border);
    border-radius: 10px;
    background: var(--western-bg);
    color: var(--western-text);
    padding: 12px 14px;
    font-size: 13px;
    font-family: inherit;
    outline: none;
    resize: none;
    box-sizing: border-box;
  }

  .contact-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .contact-form__status {
    margin: 0;
    font-size: 12px;
    font-family: var(--western-font-mono);
    color: var(--western-muted);
  }

  .contact-form__status[data-state='success'] {
    color: var(--western-accent);
  }

  .contact-form__status[data-state='error'] {
    color: var(--western-accent-2);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }

    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
