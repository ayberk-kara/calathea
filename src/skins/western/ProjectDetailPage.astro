---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Locale } from '../../lib/i18n';
import type { UIStrings } from '../../i18n';
import Prose from '../../components/Prose.astro';
import PostCard from './PostCard.astro';

interface Props {
  locale: Locale;
  t: UIStrings;
  project: CollectionEntry<'projects'>;
  Content: AstroComponentFactory;
  relatedPosts: CollectionEntry<'posts'>[];
}

const { locale, t, project, Content, relatedPosts } = Astro.props;
const { data } = project;
---

<article class="western-shell project">
  <a href={getRelativeLocaleUrl(locale, 'projects')} class="project__breadcrumb">{t.project.breadcrumb}</a>

  <div class="western-eyebrow western-eyebrow--accent">{data.index} · {data.type}</div>
  <h1 class="project__title">{data.title}</h1>
  <p class="project__summary">{data.summary}</p>

  <div class="project__stack">
    {data.stack.map((tech) => <span class="western-chip">{tech}</span>)}
  </div>

  <div class="project__links">
    {data.liveDemo && (
      <a href={data.liveDemo} target="_blank" rel="noopener" class="western-button western-button--accent">{t.project.liveDemo}</a>
    )}
    {data.repo && (
      <a href={data.repo} target="_blank" rel="noopener" class="western-button">{t.project.repo}</a>
    )}
  </div>

  {
    data.role && (
      <div class="project__meta">
        <div class="western-card project__meta-item">
          <div class="project__meta-label">{t.project.role}</div>
          <div class="project__meta-value">{data.role}</div>
        </div>
        <div class="western-card project__meta-item">
          <div class="project__meta-label">{t.project.timeline}</div>
          <div class="project__meta-value">{data.timeline}</div>
        </div>
        <div class="western-card project__meta-item">
          <div class="project__meta-label">{t.project.stack}</div>
          <div class="project__meta-value">{data.stack.slice(0, 3).join(' · ')}</div>
        </div>
        <div class="western-card project__meta-item">
          <div class="project__meta-label">{t.project.status}</div>
          <div class="project__meta-value">{data.status}</div>
        </div>
      </div>
    )
  }

  <div class="project__body">
    <Prose>
      <Content />
    </Prose>
  </div>

  {
    relatedPosts.length > 0 && (
      <div class="project__related">
        <h2 class="project__heading project__heading--accent-3">{t.project.relatedNotes}</h2>
        <div class="project__related-list">
          {relatedPosts.map((post) => <PostCard post={post} locale={locale} />)}
        </div>
      </div>
    )
  }

  <div class="project__footer">
    <a href={getRelativeLocaleUrl(locale, 'projects')} class="project__footer-link">{t.project.allProjects}</a>
    <a href={getRelativeLocaleUrl(locale, 'blog')} class="project__footer-link">{t.project.devBlog}</a>
  </div>
</article>

<style>
  .project {
    max-width: 800px;
    padding-bottom: 56px;
  }

  .project__breadcrumb {
    text-decoration: none;
    font-family: var(--western-font-mono);
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--western-muted);
  }

  .project__title {
    font-family: var(--western-font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    margin: 14px 0 18px;
  }

  .project__summary {
    font-size: 19px;
    line-height: 1.6;
    color: var(--western-muted);
    max-width: 640px;
    margin: 0 0 22px;
  }

  .project__stack {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .project__links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 40px 0 4px;
  }

  .project__meta-item {
    padding: 15px 16px;
    gap: 7px;
  }

  .project__meta-label {
    font-family: var(--western-font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--western-accent-2);
  }

  .project__meta-value {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.35;
  }

  .project__heading {
    font-family: var(--western-font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 32px);
    letter-spacing: 0.4px;
    margin: 48px 0 24px;
  }

  .project__heading--accent-3 {
    color: var(--western-accent-3);
  }

  .project__related-list {
    display: flex;
    flex-direction: column;
  }

  .project__footer {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 2.5px solid var(--western-border-strong);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .project__footer-link {
    text-decoration: none;
    font-family: var(--western-font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    border-bottom: 2px solid var(--western-accent);
    padding-bottom: 2px;
  }

  @media (max-width: 880px) {
    .project__meta {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
