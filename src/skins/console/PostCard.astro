---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { getSlug, type Locale } from '../../lib/i18n';
import { getPostPill, formatPostDate } from '../../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
  projectTitle?: string;
}

const { post, locale, projectTitle } = Astro.props;
const { data } = post;
const pill = getPostPill(post);
const href = getRelativeLocaleUrl(locale, `blog/${getSlug(post.id)}`);

const pillVariant: Record<string, string> = {
  release: pill.major ? 'console-pill--accent' : '',
  docs: 'console-pill--muted',
  'deep-dive': '',
  note: 'console-pill--muted',
};
---

<a href={href} class="post-card" data-filter-item data-filter-tags={data.tags.join(' ')}>
  <span class:list={['console-pill', pillVariant[pill.kind]]}>{pill.label}</span>
  <span class="post-card__title">{data.title}</span>
  {projectTitle && <span class="post-card__project">{projectTitle}</span>}
  <span class="post-card__date">{formatPostDate(data.date)}</span>
</a>

<style>
  .post-card {
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--console-border);
    color: var(--console-text);
  }

  .post-card__title {
    font-size: 12.5px;
    flex: 1;
    min-width: 0;
    line-height: 1.4;
  }

  .post-card__project {
    font-size: 11px;
    color: var(--console-accent);
    white-space: nowrap;
  }

  .post-card__date {
    font-size: 11px;
    color: var(--console-dim);
    white-space: nowrap;
  }
</style>
