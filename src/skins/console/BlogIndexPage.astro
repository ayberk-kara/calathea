---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../lib/i18n';
import type { UIStrings } from '../../i18n';
import PostCard from './PostCard.astro';

interface Props {
  locale: Locale;
  t: UIStrings;
  posts: CollectionEntry<'posts'>[];
  projectTitles: Map<string, string>;
}

const { locale, t, posts, projectTitles } = Astro.props;

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const statusTemplate = t.filter.showing('{visible}', '{total}', t.filter.postsNoun);
---

<header class="console-shell page-header">
  <div class="console-prompt">
    <span class="console-prompt__path">~/blog</span><span class="console-prompt__sep">$</span>
    <span class="console-prompt__cmd">find . -name "*.md"</span>
  </div>
  <h1 class="page-header__title">{t.blogPage.title}</h1>
  <p class="page-header__subtitle">{t.blogPage.subtitle}</p>
</header>

<div class="console-shell console-section">
  <div class="console-filter" data-filter-group data-filter-target="posts-list" aria-label={t.filter.tagLabel}>
    <button type="button" data-filter-value="all" aria-pressed="true">{t.filter.all}</button>
    {tags.map((tag) => <button type="button" data-filter-value={tag} aria-pressed="false">{tag}</button>)}
    <span class="console-filter__status" data-filter-status data-filter-for="posts-list" data-filter-template={statusTemplate}></span>
  </div>

  <div class="console-feed" id="posts-list" data-filter-list>
    {posts.map((post) => <PostCard post={post} locale={locale} projectTitle={projectTitles.get(post.id)} />)}
  </div>
</div>

<style>
  .page-header {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--console-border);
  }

  .page-header__title {
    margin: 8px 0 12px;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--console-heading);
    text-transform: lowercase;
  }

  .page-header__subtitle {
    margin: 0;
    max-width: 640px;
    color: var(--console-muted);
    font-size: 13px;
    line-height: 1.7;
  }
</style>
