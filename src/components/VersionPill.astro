---
interface Props {
  kind?: 'release' | 'docs' | 'deep-dive' | 'note';
  major?: boolean;
}

const { kind = 'note', major = false } = Astro.props;
---

<span
  class:list={['version-pill', `version-pill--${kind}`, { 'version-pill--major': kind === 'release' && major }]}
>
  <slot />
</span>

<style>
  .version-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.3px;
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-9);
    white-space: nowrap;
    border: var(--border-width-sm) solid var(--border-strong);
  }

  .version-pill--release {
    background: var(--accent);
    color: var(--on-accent);
  }

  .version-pill--release.version-pill--major {
    background: var(--accent-2);
    color: var(--on-accent-2);
  }

  .version-pill--docs {
    background: var(--text);
    color: var(--bg);
  }

  .version-pill--deep-dive {
    background: var(--accent-3);
    color: var(--on-accent-3);
  }

  .version-pill--note {
    background: var(--surface);
    color: var(--text-muted);
  }
</style>
