---
interface Props {
  color?: 'accent-2' | 'accent-3';
  star?: boolean;
}

const { color = 'accent-2', star = true } = Astro.props;
---

<div class:list={['eyebrow', `eyebrow--${color}`]}>{star && '★ '}<slot /></div>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .eyebrow--accent-2 {
    color: var(--accent-2);
  }

  .eyebrow--accent-3 {
    color: var(--accent-3);
  }
</style>
