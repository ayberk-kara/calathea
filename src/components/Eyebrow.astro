---
interface Props {
  color?: 'rust' | 'amber';
  star?: boolean;
}

const { color = 'rust', star = true } = Astro.props;
---

<div class:list={['eyebrow', `eyebrow--${color}`]}>{star && '★ '}<slot /></div>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .eyebrow--rust {
    color: var(--rust);
  }

  .eyebrow--amber {
    color: var(--amber);
  }
</style>
