---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { DEFAULT_LOCALE } from '../lib/i18n';

interface Props {
  active?: 'home' | 'projects' | 'blog';
}

const { active = 'home' } = Astro.props;
const locale = Astro.currentLocale ?? DEFAULT_LOCALE;

const homeHref = getRelativeLocaleUrl(locale);

const navItems = [
  { key: 'projects', href: getRelativeLocaleUrl(locale, 'projects'), label: 'Projects' },
  { key: 'blog', href: getRelativeLocaleUrl(locale, 'blog'), label: 'Blog' },
  { key: 'contact', href: `${homeHref}#contact`, label: 'Contact' },
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={homeHref} class="logo" aria-label="AK — home">AK</a>

    <nav class="nav-links" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={active === item.key ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <div class="locale-pill" role="group" aria-label="Language">
        <a href={getRelativeLocaleUrl('en')} class="locale-pill__option" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        <a href={getRelativeLocaleUrl('tr')} class="locale-pill__option" aria-current={locale === 'tr' ? 'true' : undefined}>TR</a>
      </div>

      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle color theme">
        <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.5 5.5l-2 2M7.5 16.5l-2 2M18.5 18.5l-2-2M7.5 7.5l-2-2"></path>
        </svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"></path>
        </svg>
      </button>

      <button id="nav-burger" class="icon-btn burger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Primary mobile">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav__link"
        aria-current={active === item.key ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .site-header__inner {
    max-width: var(--measure-xl);
    margin: 0 auto;
    height: var(--space-72);
    padding: 0 var(--space-36);
    display: flex;
    align-items: center;
    gap: var(--space-32);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.5px;
    color: var(--ink);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-28);
    margin-right: auto;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width-thin) solid transparent;
  }

  .nav-link[aria-current='page'] {
    color: var(--rust);
    border-bottom-color: var(--rust);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    flex: 0 0 auto;
  }

  .locale-pill {
    display: inline-flex;
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.5px;
  }

  .locale-pill__option {
    padding: var(--space-6) var(--space-12);
    text-decoration: none;
    color: var(--ink);
  }

  .locale-pill__option[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-40);
    height: var(--space-40);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    padding: 0;
  }

  .icon {
    width: var(--space-18);
    height: var(--space-18);
  }

  .icon--sun,
  .icon--moon {
    display: none;
  }

  html[data-theme='light'] .icon--moon {
    display: block;
  }

  html[data-theme='dark'] .icon--sun {
    display: block;
  }

  .burger {
    display: none;
  }

  .burger svg {
    width: var(--space-18);
    height: var(--space-18);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    border-top: var(--border-width) solid var(--border-strong);
    padding: var(--space-12) var(--space-36);
  }

  .mobile-nav__link {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding: var(--space-12) 0;
    border-bottom: var(--border-width-thin) solid var(--border);
  }

  .mobile-nav__link:last-child {
    border-bottom: none;
  }

  .mobile-nav__link[aria-current='page'] {
    color: var(--rust);
  }

  .site-header.is-open .mobile-nav {
    display: flex;
  }

  @media (max-width: 880px) {
    .nav-links {
      display: none;
    }

    .burger {
      display: inline-flex;
    }
  }
</style>

<script>
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch (e) {
      /* localStorage unavailable */
    }
  });

  const header = document.querySelector('.site-header');
  const burger = document.getElementById('nav-burger');

  burger?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
