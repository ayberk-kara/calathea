---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionHeader from '../SectionHeader.astro';
import ProjectCard from '../ProjectCard.astro';
import { DEFAULT_LOCALE, localizeAll, type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);

const featured = localizeAll(await getCollection('projects'), locale)
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.index.localeCompare(b.data.index))
  .slice(0, 3);
---

<section class="featured-projects" id="projects">
  <SectionHeader color="rust" actionLabel={t.home.projectsViewAll} actionHref={getRelativeLocaleUrl(locale, 'projects')}>{t.home.projectsHeading}</SectionHeader>
  <div class="featured-projects__grid">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .featured-projects {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-44) var(--space-36) var(--space-24);
  }

  .featured-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }

  @media (max-width: 880px) {
    .featured-projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
