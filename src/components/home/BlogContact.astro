---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionHeader from '../SectionHeader.astro';
import VersionPill from '../VersionPill.astro';
import Button from '../Button.astro';
import { getPostPill, formatRelativeDate } from '../../lib/posts';
import { DEFAULT_LOCALE, getSlug, localizeAll, type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);

const feed = localizeAll(await getCollection('posts'), locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<section class="blog-contact">
  <div class="blog-contact__col">
    <SectionHeader color="amber" size="md" actionLabel={t.home.blogAllPosts} actionHref={getRelativeLocaleUrl(locale, 'blog')}>
      {t.home.blogHeading}
    </SectionHeader>
    <div class="blog-contact__feed">
      {feed.map((post) => {
        const pill = getPostPill(post);
        return (
          <a href={getRelativeLocaleUrl(locale, `blog/${getSlug(post.id)}`)} class="feed-row">
            <VersionPill kind={pill.kind} major={pill.major}>{pill.label}</VersionPill>
            <span class="feed-row__title">{post.data.title}</span>
            <span class="feed-row__time">{formatRelativeDate(post.data.date)}</span>
          </a>
        );
      })}
    </div>
  </div>

  <div class="blog-contact__col" id="contact">
    <SectionHeader color="rust" size="md">{t.home.contactHeading}</SectionHeader>
    <form
      class="contact-form"
      data-contact-form
      data-sending-text={t.home.contactSending}
      data-success-text={t.home.contactSuccess}
      data-error-text={t.home.contactError}
    >
      <div class="contact-form__row">
        <label class="sr-only" for="contact-name">{t.home.contactNameLabel}</label>
        <input class="field" id="contact-name" type="text" name="name" placeholder={t.home.contactName} required />
        <label class="sr-only" for="contact-email">{t.home.contactEmailLabel}</label>
        <input class="field" id="contact-email" type="email" name="email" placeholder={t.home.contactEmail} required />
      </div>
      <label class="sr-only" for="contact-subject">{t.home.contactSubjectLabel}</label>
      <input class="field" id="contact-subject" type="text" name="subject" placeholder={t.home.contactSubject} />
      <label class="sr-only" for="contact-message">{t.home.contactMessageLabel}</label>
      <textarea class="field field--area" id="contact-message" name="message" placeholder={t.home.contactMessage} rows="5" required></textarea>
      <div class="sr-only" aria-hidden="true">
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>
      <div class="contact-form__footer">
        <p class="contact-form__status" data-contact-status role="status" aria-live="polite"></p>
        <Button type="submit" variant="accent">{t.home.contactSend}</Button>
      </div>
    </form>
  </div>
</section>

<style>
  .blog-contact {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-40) var(--space-36) var(--space-32);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    gap: var(--space-40);
  }

  .blog-contact__col {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
  }

  .blog-contact__feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-11);
  }

  .feed-row {
    text-decoration: none;
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-14) var(--space-18);
    background: var(--card);
    display: flex;
    align-items: center;
    gap: var(--space-13);
    transition: border-color 0.15s;
  }

  .feed-row:hover {
    border-color: var(--rust);
  }

  .feed-row__title {
    font-weight: 700;
    font-size: 14.5px;
    flex: 1;
    color: var(--ink);
  }

  .feed-row__time {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .contact-form {
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: var(--card);
    padding: var(--space-22);
    display: flex;
    flex-direction: column;
    gap: var(--space-13);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-13);
  }

  .field {
    width: 100%;
    border: var(--border-width) solid var(--field-line);
    border-radius: var(--radius-md);
    background: var(--field);
    color: var(--ink);
    padding: var(--space-11) var(--space-14);
    font-size: 14.5px;
    outline: none;
  }

  .field--area {
    resize: vertical;
    min-height: var(--space-96);
  }

  .contact-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-13);
  }

  .contact-form__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--muted);
  }

  .contact-form__status[data-state='success'] {
    color: var(--olive);
  }

  .contact-form__status[data-state='error'] {
    color: var(--rust);
  }

  .contact-form :global(.btn:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 880px) {
    .blog-contact {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .blog-contact__col {
      display: block;
      grid-row: auto;
    }

    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__footer {
      flex-direction: column-reverse;
      align-items: stretch;
    }
  }
</style>

<script>
  const ENDPOINT = 'https://api.web3forms.com/submit';
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && submitBtn) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      if (data.get('botcheck')) return;

      const idleLabel = submitBtn.textContent ?? '';

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sendingText ?? idleLabel;
      status.textContent = '';
      status.removeAttribute('data-state');

      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: accessKey,
            name: data.get('name'),
            email: data.get('email'),
            subject: data.get('subject'),
            message: data.get('message'),
          }),
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.message ?? 'submission failed');
        }

        form.reset();
        status.textContent = form.dataset.successText ?? '';
        status.dataset.state = 'success';
      } catch {
        status.textContent = form.dataset.errorText ?? '';
        status.dataset.state = 'error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = idleLabel;
      }
    });
  }
</script>
