---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);
---

<header class="hero">
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <filter id="ak-rough">
      <feTurbulence type="fractalNoise" baseFrequency="0.013 0.018" numOctaves="2" seed="7" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4"></feDisplacementMap>
    </filter>
  </svg>

  <div class="hero__intro">
    <Eyebrow color="accent-2">{t.home.heroEyebrow}</Eyebrow>
    <h1 class="hero__heading">{t.home.heroGreeting}<br />{t.home.heroName}</h1>
    <p class="hero__lead">
      {t.home.heroLead}
    </p>
    <div class="hero__actions">
      <Button href={getRelativeLocaleUrl(locale, 'projects')} variant="filled">{t.home.viewProjects}</Button>
      <Button href="/cv.pdf" variant="outline">{t.home.downloadCv}</Button>
    </div>
  </div>

  <div class="hero__links">
    <a class="hero__social-link" href="https://github.com/ayberk-kara" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg class="hero__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z"></path>
      </svg>
      <span>GitHub</span>
    </a>
    <a class="hero__social-link" href="https://www.linkedin.com/in/ayberk-kara" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <svg class="hero__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
</header>

<style>
  .hero {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-56) var(--space-36) var(--space-28);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-56);
    align-items: center;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 5.2vw, 76px);
    line-height: 0.96;
    margin: 0 0 var(--space-22);
    letter-spacing: 0.5px;
    color: var(--text);
    filter: url(#ak-rough);
  }

  .hero__lead {
    font-size: 17.5px;
    line-height: 1.62;
    color: var(--text);
    opacity: 0.9;
    max-width: 440px;
    margin: 0 0 var(--space-28);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-13);
    flex-wrap: wrap;
  }

  .hero__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
  }

  .hero__social-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-18) var(--space-24);
    border: var(--border-width) solid var(--on-accent);
    border-radius: var(--radius-lg);
    background: var(--accent-shade);
    color: var(--on-accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: transform 0.15s, background 0.15s;
  }

  .hero__social-link:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }

  .hero__social-icon {
    width: var(--space-32);
    height: var(--space-32);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
