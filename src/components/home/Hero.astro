---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import StatChip from '../StatChip.astro';
import { stats } from '../../data/profile';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);
---

<header class="hero">
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <filter id="ak-rough">
      <feTurbulence type="fractalNoise" baseFrequency="0.013 0.018" numOctaves="2" seed="7" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4"></feDisplacementMap>
    </filter>
  </svg>

  <div class="hero__intro">
    <Eyebrow color="rust">{t.home.heroEyebrow}</Eyebrow>
    <h1 class="hero__heading">{t.home.heroGreeting}<br />{t.home.heroName}</h1>
    <p class="hero__lead">
      {t.home.heroLead}
    </p>
    <div class="hero__actions">
      <Button href={getRelativeLocaleUrl(locale, 'projects')} variant="filled">{t.home.viewProjects}</Button>
      <Button href="/cv.pdf" variant="outline">{t.home.downloadCv}</Button>
    </div>
  </div>

  <div class="hero__portrait">
    <div class="hero__portrait-art">
      <span class="hero__portrait-label">{t.home.portraitLabel}</span>
    </div>
    <div class="hero__stats">
      {stats.map((stat) => <StatChip>{stat}</StatChip>)}
    </div>
  </div>
</header>

<style>
  .hero {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-56) var(--space-36) var(--space-28);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-56);
    align-items: center;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(46px, 6.6vw, 92px);
    line-height: 0.96;
    margin: 0 0 var(--space-22);
    letter-spacing: 0.5px;
    color: var(--ink);
    filter: url(#ak-rough);
  }

  .hero__lead {
    font-size: 17.5px;
    line-height: 1.62;
    color: var(--ink);
    opacity: 0.9;
    max-width: 440px;
    margin: 0 0 var(--space-28);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-13);
    flex-wrap: wrap;
  }

  .hero__portrait {
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--space-9) var(--space-9) 0 var(--olive);
  }

  .hero__portrait-art {
    position: relative;
    aspect-ratio: 1.35 / 1;
    background: repeating-linear-gradient(135deg, var(--stripe-a) 0 18px, var(--stripe-b) 18px 36px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__portrait-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--on-olive);
    opacity: 0.92;
  }

  .hero__stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-14) var(--space-22);
    gap: var(--space-10);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
