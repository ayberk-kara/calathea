---
import SectionHeader from '../SectionHeader.astro';
import ExperienceRow from '../ExperienceRow.astro';
import EducationRow from '../EducationRow.astro';
import { experience, education } from '../../data/profile';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { getUI } from '../../i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);
---

<section class="experience-education" id="experience">
  <div class="experience-education__col">
    <SectionHeader color="accent-2">
      {t.home.experienceHeading}
      <Fragment slot="action">
        <div class="exp-toggle" data-exp-toggle role="group" aria-label={t.home.experienceFilterAriaLabel}>
          <button type="button" class="exp-toggle__btn" data-filter="all">{t.home.experienceFilterAll}</button>
          <button type="button" class="exp-toggle__btn is-active" data-filter="eng">{t.home.experienceFilterEng}</button>
        </div>
      </Fragment>
    </SectionHeader>
    <div class="experience-education__rows" data-exp-rows data-filter="eng">
      {experience.map((entry) => (
        <ExperienceRow
          title={`${entry.title} · ${entry.org}`}
          range={entry.range}
          summary={entry.summary}
          bullets={entry.bullets}
          nonEng={!entry.eng}
        />
      ))}
    </div>
  </div>

  <div class="experience-education__col">
    <SectionHeader color="accent">{t.home.educationHeading}</SectionHeader>
    <div class="experience-education__rows">
      {education.map((entry) => (
        <EducationRow
          degree={entry.degree}
          org={entry.org}
          location={entry.location}
          range={entry.range}
          summary={entry.summary}
          bullets={entry.bullets}
          coursework={entry.coursework}
          highlight={entry.highlight}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .experience-education {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-40) var(--space-36) var(--space-24);
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-40);
  }

  .experience-education__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .exp-toggle {
    display: inline-flex;
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.5px;
  }

  .exp-toggle__btn {
    border: none;
    cursor: pointer;
    padding: var(--space-7) var(--space-15);
    font-family: inherit;
    letter-spacing: inherit;
    background: transparent;
    color: var(--text);
  }

  .exp-toggle__btn.is-active {
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
  }

  [data-filter='eng'] :global(.experience-row--non-eng) {
    display: none;
  }

  @media (max-width: 880px) {
    .experience-education {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-exp-toggle]');
  const rows = document.querySelector('[data-exp-rows]');

  toggle?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest('button[data-filter]');
    if (!(button instanceof HTMLButtonElement) || !rows) return;

    rows.setAttribute('data-filter', button.dataset.filter ?? 'eng');
    toggle.querySelectorAll('button').forEach((b) => b.classList.toggle('is-active', b === button));
  });
</script>
