---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Card from './Card.astro';
import TagChip from './TagChip.astro';
import VersionPill from './VersionPill.astro';
import { getPostPill, formatPostDate, getReadingTime } from '../lib/posts';
import { DEFAULT_LOCALE, getSlug, type Locale } from '../lib/i18n';
import { getUI } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'>;
  projectTitle?: string;
}

const { post, projectTitle } = Astro.props;
const { data, body } = post;
const pill = getPostPill(post);
const read = getReadingTime(body ?? '');
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);
---

<Card href={getRelativeLocaleUrl(locale, `blog/${getSlug(post.id)}`)} interactive data-tags={data.tags.join(' ')}>
  <div class="post-row">
    <div class="post-row__main">
      <div class="post-row__tags">
        <VersionPill kind={pill.kind} major={pill.major}>{pill.label}</VersionPill>
        {data.tags.map((tag) => <TagChip variant="muted">{tag}</TagChip>)}
      </div>
      <span class="post-row__title">{data.title}</span>
      <span class="post-row__excerpt">{data.excerpt}</span>
    </div>
    <div class="post-row__meta">
      <span>{formatPostDate(data.date)}</span>
      <span>{t.post.readingTime(read)}</span>
      {projectTitle && <span class="post-row__project">↳ {projectTitle}</span>}
    </div>
  </div>
</Card>

<style>
  .post-row {
    display: flex;
    gap: var(--space-22);
    align-items: flex-start;
  }

  .post-row__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }

  .post-row__tags {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .post-row__title {
    font-size: 20px;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.25;
  }

  .post-row__excerpt {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink);
    opacity: 0.82;
  }

  .post-row__meta {
    flex: 0 0 auto;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .post-row__project {
    margin-top: var(--space-4);
    color: var(--rust);
    font-weight: 700;
  }

  @media (max-width: 880px) {
    .post-row {
      flex-direction: column;
    }

    .post-row__meta {
      text-align: left;
    }
  }
</style>
