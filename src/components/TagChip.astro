---
interface Props {
  variant?: 'default' | 'muted' | 'inverse';
}

const { variant = 'default' } = Astro.props;
---

<span class:list={['tag-chip', `tag-chip--${variant}`]}>
  <slot />
</span>

<style>
  .tag-chip {
    display: inline-block;
    font-family: var(--font-mono);
    border-radius: var(--radius-pill);
    line-height: 1.4;
  }

  .tag-chip--default {
    font-size: 11px;
    border: var(--border-width-sm) solid var(--border-strong);
    padding: var(--space-3) var(--space-11);
    color: var(--text);
  }

  .tag-chip--text-muted {
    font-size: 10.5px;
    border: var(--border-width-thin) solid var(--border);
    padding: var(--space-2) var(--space-9);
    color: var(--text-muted);
  }

  .tag-chip--inverse {
    font-size: 12px;
    border: var(--border-width-sm) solid currentColor;
    padding: var(--space-4) var(--space-12);
    color: inherit;
  }
</style>
