---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  color?: 'accent-2' | 'accent-3';
  measure?: 'md' | 'xl';
}

const { eyebrow, title, subtitle, color = 'accent-2', measure = 'xl' } = Astro.props;
---

<header class:list={['page-header', `page-header--${measure}`]}>
  <Eyebrow color={color}>{eyebrow}</Eyebrow>
  <h1 class:list={['page-header__title', `page-header__title--${color}`]}>{title}</h1>
  <p class="page-header__subtitle">{subtitle}</p>
</header>

<style>
  .page-header {
    margin: 0 auto;
    padding: var(--space-48) var(--space-36) var(--space-18);
  }

  .page-header--xl {
    max-width: var(--measure-xl);
  }

  .page-header--md {
    max-width: var(--measure-md);
  }

  .page-header__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 5.6vw, 74px);
    line-height: 1;
    margin: var(--space-14) 0;
    letter-spacing: 0.5px;
  }

  .page-header__title--accent-2 {
    color: var(--accent-2);
  }

  .page-header__title--accent-3 {
    color: var(--accent-3);
  }

  .page-header__subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.88;
    max-width: var(--measure-sm);
    margin: 0;
  }
</style>
