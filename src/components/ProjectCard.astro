---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Card from './Card.astro';
import TagChip from './TagChip.astro';
import { DEFAULT_LOCALE, getSlug } from '../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { id, data } = project;
const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
---

<Card href={getRelativeLocaleUrl(locale, `projects/${getSlug(id)}`)} interactive data-tags={data.tags.join(' ')}>
  <div class="project-card__top">
    <span class="project-card__meta">{data.index} · {data.type}</span>
    {data.liveDemo && <span class="project-card__badge">LIVE DEMO</span>}
  </div>
  <span class="project-card__title">{data.title}</span>
  <span class="project-card__summary">{data.summary}</span>
  <div class="project-card__tags">
    {data.stack.map((tech) => <TagChip>{tech}</TagChip>)}
  </div>
</Card>

<style>
  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .project-card__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .project-card__badge {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1px;
    background: var(--accent-2);
    color: var(--on-accent-2);
    border-radius: var(--radius-xs);
    padding: var(--space-2) var(--space-7);
  }

  .project-card__title {
    font-size: 21px;
    font-weight: 800;
    color: var(--text);
    line-height: 1.15;
  }

  .project-card__summary {
    color: var(--text);
    opacity: 0.82;
    font-size: 14.5px;
    line-height: 1.5;
    flex: 1;
  }

  .project-card__tags {
    display: flex;
    gap: var(--space-7);
    flex-wrap: wrap;
  }
</style>
