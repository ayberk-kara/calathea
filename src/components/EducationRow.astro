---
interface Props {
  degree: string;
  org: string;
  location?: string;
  range: string;
  summary?: string;
  bullets?: string[];
  highlight?: boolean;
}

const { degree, org, location, range, summary, bullets = [], highlight = false } = Astro.props;
const line = [org, location].filter(Boolean).join(' · ');
---

<div class:list={['education-row', { 'education-row--highlight': highlight }]} tabindex="0">
  <div class="education-row__main">
    <div class="education-row__degree">{degree}</div>
    <div class="education-row__line">{line}</div>
    {summary && <p class="education-row__desc">{summary}</p>}
    {bullets.length > 0 && (
      <div class="education-row__details">
        <ul class="education-row__bullets">
          {bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    )}
  </div>
  <div class="education-row__year">{range}</div>
</div>

<style>
  .education-row {
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-15) var(--space-20);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
    background: var(--card);
    color: var(--ink);
  }

  .education-row--highlight {
    background: var(--olive);
    color: var(--on-olive);
  }

  .education-row__degree {
    font-weight: 800;
    font-size: 16.5px;
  }

  .education-row__line {
    font-size: 13.5px;
    margin-top: var(--space-5);
    opacity: 0.82;
  }

  .education-row__year {
    font-family: var(--font-mono);
    font-size: 11.5px;
    white-space: nowrap;
    opacity: 0.85;
  }

  .education-row__desc {
    font-size: 13.5px;
    line-height: 1.5;
    margin: var(--space-7) 0 0;
    opacity: 0.82;
  }

  .education-row__details {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    margin-top: 0;
    transition: grid-template-rows 0.25s ease, margin-top 0.25s ease;
  }

  .education-row:hover .education-row__details,
  .education-row:focus-within .education-row__details {
    grid-template-rows: 1fr;
    margin-top: var(--space-7);
  }

  .education-row__bullets {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    list-style: none;
  }

  .education-row__bullets li {
    position: relative;
    padding-left: var(--space-14);
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.82;
  }

  .education-row__bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--rust);
  }

  .education-row--highlight .education-row__bullets li::before {
    color: var(--on-olive);
  }

  .education-row:focus-visible {
    outline: var(--border-width-focus) solid var(--amber);
    outline-offset: 2px;
  }
</style>
