---
interface Props {
  color?: 'rust' | 'olive' | 'amber';
  size?: 'lg' | 'md';
  actionLabel?: string;
  actionHref?: string;
}

const { color = 'rust', size = 'lg', actionLabel, actionHref } = Astro.props;
---

<div class:list={['section-header', `section-header--${size}`]}>
  <h2 class:list={['section-header__title', `section-header__title--${color}`]}>
    <slot />
  </h2>
  {actionLabel && actionHref && (
    <a href={actionHref} class:list={['section-header__action', `section-header__action--${color}`]}>
      {actionLabel} →
    </a>
  )}
</div>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
    margin-bottom: var(--space-20);
  }

  .section-header__title {
    font-family: var(--font-display);
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .section-header--lg .section-header__title {
    font-size: clamp(30px, 4vw, 46px);
  }

  .section-header--md .section-header__title {
    font-size: clamp(26px, 3.4vw, 40px);
  }

  .section-header__title--rust {
    color: var(--rust);
  }

  .section-header__title--olive {
    color: var(--olive);
  }

  .section-header__title--amber {
    color: var(--amber);
  }

  .section-header__action {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 1px;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width-sm) solid transparent;
    white-space: nowrap;
  }

  .section-header__action--rust {
    border-bottom-color: var(--rust);
  }

  .section-header__action--olive {
    border-bottom-color: var(--olive);
  }

  .section-header__action--amber {
    border-bottom-color: var(--amber);
  }
</style>
