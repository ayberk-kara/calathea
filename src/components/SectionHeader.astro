---
interface Props {
  color?: 'accent' | 'accent-2' | 'accent-3';
  size?: 'lg' | 'md';
  actionLabel?: string;
  actionHref?: string;
}

const { color = 'accent-2', size = 'lg', actionLabel, actionHref } = Astro.props;
---

<div class:list={['section-header', `section-header--${size}`]}>
  <h2 class:list={['section-header__title', `section-header__title--${color}`]}>
    <slot />
  </h2>
  <slot name="action">
    {actionLabel && actionHref && (
      <a href={actionHref} class:list={['section-header__action', `section-header__action--${color}`]}>
        {actionLabel} →
      </a>
    )}
  </slot>
</div>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
    margin-bottom: var(--space-20);
  }

  .section-header__title {
    font-family: var(--font-display);
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .section-header--lg .section-header__title {
    font-size: clamp(30px, 4vw, 46px);
  }

  .section-header--md .section-header__title {
    font-size: clamp(26px, 3.4vw, 40px);
  }

  .section-header__title--accent-2 {
    color: var(--accent-2);
  }

  .section-header__title--accent {
    color: var(--accent);
  }

  .section-header__title--accent-3 {
    color: var(--accent-3);
  }

  .section-header__action {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 1px;
    text-decoration: none;
    color: var(--text);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width-sm) solid transparent;
    white-space: nowrap;
  }

  .section-header__action--accent-2 {
    border-bottom-color: var(--accent-2);
  }

  .section-header__action--accent {
    border-bottom-color: var(--accent);
  }

  .section-header__action--accent-3 {
    border-bottom-color: var(--accent-3);
  }
</style>
