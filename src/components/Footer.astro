---
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { getUI } from '../i18n';

const year = new Date().getFullYear();
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getUI(locale);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <span class="site-footer__copy">{t.footer.copy(year)}</span>
    <!--
      TODO: re-add the "press ~ for terminal · ⌘K to search" hint here once the
      command palette and terminal-mode easter egg ship.
    -->
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--border-strong);
  }

  .site-footer__inner {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-24) var(--space-36) var(--space-56);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-14);
  }

  .site-footer__copy {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 1px;
    color: var(--muted);
  }
</style>
