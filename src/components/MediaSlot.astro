---
interface Props {
  kind?: 'gallery' | 'architecture' | 'video';
  ratio: string;
  label: string;
  src?: string;
  alt?: string;
  embedUrl?: string;
}

const { kind = 'gallery', ratio, label, src, alt = '', embedUrl } = Astro.props;
---

{embedUrl ? (
  <div class="media-slot media-slot--embed" style={`aspect-ratio: ${ratio};`}>
    <iframe
      src={embedUrl}
      title={label}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
) : src ? (
  <img class="media-slot media-slot--image" style={`aspect-ratio: ${ratio};`} src={src} alt={alt} />
) : kind === 'video' ? (
  <div class="media-slot media-slot--placeholder media-slot--video" style={`aspect-ratio: ${ratio};`}>
    <span class="media-slot__play">▶</span>
    <span class="media-slot__label">{label}</span>
    <span class="media-slot__note">// drop an &lt;iframe&gt; embed here at build time — never a committed file</span>
  </div>
) : (
  <div class="media-slot media-slot--placeholder" style={`aspect-ratio: ${ratio};`}>
    <span class="media-slot__label">{label}</span>
  </div>
)}

<style>
  .media-slot {
    width: 100%;
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .media-slot--embed {
    overflow: hidden;
  }

  .media-slot--embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .media-slot--image {
    object-fit: cover;
  }

  .media-slot--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-14);
    text-align: center;
    background: var(--field);
    color: var(--muted);
    padding: var(--space-16);
  }

  .media-slot__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
  }

  .media-slot--video {
    background: repeating-linear-gradient(135deg, var(--stripe-a) 0 22px, var(--stripe-b) 22px 44px);
    color: var(--on-olive);
  }

  .media-slot--video .media-slot__label {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .media-slot--video .media-slot__note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    opacity: 0.8;
  }

  .media-slot__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-64);
    height: var(--space-64);
    border-radius: var(--radius-pill);
    background: var(--rust);
    color: var(--on-rust);
    border: var(--border-width) solid var(--card);
    font-size: 22px;
    padding-left: var(--space-5);
  }
</style>
