---
// Demo content for the component sandbox at /preview. Rendered once per theme
// pane. Not part of the production site — safe to delete with src/pages/preview.
import Button from '../Button.astro';
import Card from '../Card.astro';
import TagChip from '../TagChip.astro';
import SectionHeader from '../SectionHeader.astro';
import StatChip from '../StatChip.astro';
import ExperienceRow from '../ExperienceRow.astro';
import EducationRow from '../EducationRow.astro';
import VersionPill from '../VersionPill.astro';
import Eyebrow from '../Eyebrow.astro';
---

<div class="sample">
  <p class="sample__label">EYEBROW</p>
  <Eyebrow color="rust">DESIGNER OF SYSTEMS, NOT JUST MODELS</Eyebrow>
  <Eyebrow color="amber" star={false}>DEV NOTES &amp; RELEASES</Eyebrow>
</div>

<div class="sample">
  <p class="sample__label">BUTTON</p>
  <div class="row">
    <Button variant="filled">View projects</Button>
    <Button variant="outline">Download CV</Button>
    <Button variant="accent" size="sm">Send message →</Button>
  </div>
</div>

<div class="sample">
  <p class="sample__label">TAGCHIP</p>
  <div class="row">
    <TagChip>CUDA</TagChip>
    <TagChip>Python</TagChip>
    <TagChip variant="muted">cuda</TagChip>
    <TagChip variant="muted">optimization</TagChip>
    <div class="swatch swatch--olive row">
      <TagChip variant="inverse">Rust</TagChip>
      <TagChip variant="inverse">Go</TagChip>
    </div>
  </div>
</div>

<div class="sample">
  <p class="sample__label">SECTIONHEADER</p>
  <div class="stack">
    <SectionHeader color="rust" actionLabel="view all projects" actionHref="#">PROJECTS</SectionHeader>
    <SectionHeader color="olive">SKILLS</SectionHeader>
    <SectionHeader color="amber" size="md" actionLabel="all posts" actionHref="#">DEV BLOG &amp; RELEASES</SectionHeader>
  </div>
</div>

<div class="sample">
  <p class="sample__label">CARD</p>
  <Card href="#" interactive>
    <TagChip>02 · SYSTEMS</TagChip>
    <strong>GPU-Optimized Inference Pipeline</strong>
    <span>Fused attention, paged KV-cache, and hand-written CUDA kernels.</span>
    <div class="row">
      <TagChip>CUDA</TagChip>
      <TagChip>TensorRT</TagChip>
    </div>
  </Card>
</div>

<div class="sample">
  <p class="sample__label">STATCHIP</p>
  <div class="row">
    <StatChip>5+ yrs</StatChip>
    <StatChip>30+ models shipped</StatChip>
    <StatChip>OSS maintainer</StatChip>
  </div>
</div>

<div class="sample">
  <p class="sample__label">EXPERIENCEROW</p>
  <div class="stack">
    <ExperienceRow
      title="Senior ML Systems Engineer · Acme Corp"
      range="2024 — Present"
      description="Leading the inference platform team."
    />
    <ExperienceRow title="Line Cook · Riverside Diner" range="2016 — 2018" nonEng />
  </div>
</div>

<div class="sample">
  <p class="sample__label">EDUCATIONROW</p>
  <div class="stack">
    <EducationRow degree="M.S. Computer Science" line="Stanford University · Systems" year="2023" highlight />
    <EducationRow degree="B.S. Electrical Engineering" line="UC Berkeley" year="2019" />
  </div>
</div>

<div class="sample">
  <p class="sample__label">VERSIONPILL</p>
  <div class="row">
    <VersionPill kind="release" major>v2.0.0</VersionPill>
    <VersionPill kind="release">v2.1.0</VersionPill>
    <VersionPill kind="docs">DOCS</VersionPill>
    <VersionPill kind="deep-dive">DEEP DIVE</VersionPill>
    <VersionPill kind="note">DEV NOTE</VersionPill>
  </div>
</div>

<style>
  .sample {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .sample__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin: 0;
  }

  .row {
    display: flex;
    gap: var(--space-12);
    flex-wrap: wrap;
    align-items: center;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .swatch {
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-22);
  }

  .swatch--olive {
    background: var(--olive);
    color: var(--on-olive);
  }
</style>
