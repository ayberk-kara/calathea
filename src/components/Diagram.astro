---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="diagram">
  <div class="diagram__frame">
    <Image src={src} alt={alt} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 32px 0;
  }

  .diagram__frame {
    background: var(--prose-surface);
    border: 1.5px solid var(--prose-border);
    border-radius: 10px;
    padding: 18px;
    text-align: center;
  }

  .diagram__frame :global(img) {
    display: inline-block;
    max-width: 100%;
    height: auto;
  }

  .diagram figcaption {
    margin-top: 8px;
    font-family: var(--prose-font-mono);
    font-size: 13px;
    color: var(--prose-text);
    opacity: 0.65;
    text-align: center;
  }
</style>
