---
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure-sm);
  }

  .prose :global(p) {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text);
    opacity: 0.94;
    margin: 0 0 var(--space-20);
  }

  .prose :global(h2) {
    font-size: 24px;
    font-weight: 800;
    margin: var(--space-36) 0 var(--space-14);
    color: var(--text);
    letter-spacing: -0.2px;
  }

  .prose :global(h3) {
    font-size: 19px;
    font-weight: 800;
    margin: var(--space-28) 0 var(--space-10);
    color: var(--text);
  }

  .prose :global(strong) {
    font-weight: 800;
  }

  .prose :global(ul),
  .prose :global(ol) {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text);
    opacity: 0.94;
    padding-left: var(--space-24);
    margin: 0 0 var(--space-20);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: color-mix(in srgb, var(--accent-3) 16%, var(--surface));
    border: var(--border-width-thin) solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-6);
  }

  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.7;
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-18) var(--space-20);
    overflow: auto;
    margin: 0 0 var(--space-22);
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 1em;
  }

  .prose :global(a) {
    color: var(--accent-2);
    font-weight: 700;
    text-decoration: none;
    border-bottom: var(--border-width-sm) solid var(--accent-2);
  }
</style>
