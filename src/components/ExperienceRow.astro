---
interface Props {
  title: string;
  range: string;
  description?: string;
  nonEng?: boolean;
}

const { title, range, description, nonEng = false } = Astro.props;
---

<div class:list={['experience-row', { 'experience-row--non-eng': nonEng }]}>
  <div class="experience-row__main">
    <div class="experience-row__heading">
      <span class="experience-row__title">{title}</span>
      {nonEng && <span class="experience-row__tag">non-eng</span>}
    </div>
    {description && <p class="experience-row__desc">{description}</p>}
  </div>
  <div class="experience-row__range">{range}</div>
</div>

<style>
  .experience-row {
    border-radius: var(--radius-lg);
    padding: var(--space-15) var(--space-20);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
    border: var(--border-width) solid var(--border-strong);
    background: var(--card);
  }

  .experience-row--non-eng {
    border-style: dashed;
    background: transparent;
    opacity: 0.62;
    padding: var(--space-13) var(--space-20);
    align-items: center;
  }

  .experience-row__main {
    flex: 1;
    min-width: 0;
  }

  .experience-row__heading {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .experience-row__title {
    font-weight: 800;
    font-size: 16.5px;
    line-height: 1.25;
    color: var(--ink);
  }

  .experience-row__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    background: var(--amber);
    color: var(--on-amber);
    border-radius: var(--radius-xs);
    padding: var(--space-2) var(--space-7);
  }

  .experience-row__desc {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
    margin: var(--space-7) 0 0;
  }

  .experience-row__range {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
