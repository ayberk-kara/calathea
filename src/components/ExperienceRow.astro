---
interface Props {
  title: string;
  range: string;
  summary?: string;
  bullets?: string[];
  nonEng?: boolean;
}

const { title, range, summary, bullets = [], nonEng = false } = Astro.props;
---

<div class:list={['experience-row', { 'experience-row--non-eng': nonEng }]} tabindex="0">
  <div class="experience-row__main">
    <div class="experience-row__heading">
      <span class="experience-row__title">{title}</span>
      {nonEng && <span class="experience-row__tag">non-eng</span>}
    </div>
    {summary && <p class="experience-row__desc">{summary}</p>}
    {bullets.length > 0 && (
      <div class="experience-row__details">
        <ul class="experience-row__bullets">
          {bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    )}
  </div>
  <div class="experience-row__range">{range}</div>
</div>

<style>
  .experience-row {
    border-radius: var(--radius-lg);
    padding: var(--space-15) var(--space-20);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-16);
    border: var(--border-width) solid var(--border-strong);
    background: var(--card);
  }

  .experience-row--non-eng {
    border-style: dashed;
  }

  .experience-row__main {
    flex: 1;
    min-width: 0;
  }

  .experience-row__heading {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .experience-row__title {
    font-weight: 800;
    font-size: 16.5px;
    line-height: 1.25;
    color: var(--ink);
  }

  .experience-row__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    background: var(--amber);
    color: var(--on-amber);
    border-radius: var(--radius-xs);
    padding: var(--space-2) var(--space-7);
  }

  .experience-row__desc {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
    margin: var(--space-7) 0 0;
  }

  .experience-row__range {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .experience-row__details {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    margin-top: 0;
    transition: grid-template-rows 0.25s ease, margin-top 0.25s ease;
  }

  .experience-row:hover .experience-row__details,
  .experience-row:focus-within .experience-row__details {
    grid-template-rows: 1fr;
    margin-top: var(--space-7);
  }

  .experience-row__bullets {
    margin: 0;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    list-style: none;
  }

  .experience-row__bullets li {
    position: relative;
    padding-left: var(--space-14);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .experience-row__bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--rust);
  }

  .experience-row:focus-visible {
    outline: var(--border-width-focus) solid var(--amber);
    outline-offset: 2px;
  }
</style>
