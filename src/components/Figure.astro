---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 28px 0;
  }

  .figure :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border: 1.5px solid var(--prose-border);
    border-radius: 8px;
  }

  .figure figcaption {
    margin-top: 8px;
    font-family: var(--prose-font-mono);
    font-size: 13px;
    color: var(--prose-text);
    opacity: 0.65;
    text-align: center;
  }
</style>
