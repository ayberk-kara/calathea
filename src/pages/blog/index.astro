---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagFilter from '../../components/TagFilter.astro';
import PostRow from '../../components/PostRow.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectTitles = new Map<string, string>();
for (const post of posts) {
  if (post.data.project) {
    const project = await getEntry(post.data.project);
    if (project) projectTitles.set(post.id, project.data.title);
  }
}
---

<BaseLayout
  title="Blog — AK"
  description="Notes from the kernel mines — deep dives, dev notes, and release logs, cross-linked to the projects they came out of."
  active="blog"
>
  <PageHeader
    color="amber"
    measure="md"
    eyebrow="DEV NOTES & RELEASES"
    title="THE BLOG"
    subtitle="Notes from the kernel mines — deep dives, short dev notes, and release logs. Cross-linked to the projects they came out of."
  />

  <TagFilter items={posts.map((p) => ({ tags: p.data.tags }))} activeColor="amber" label="TAG" noun="posts" />

  <section class="post-list">
    {posts.map((post) => <PostRow post={post} projectTitle={projectTitles.get(post.id)} />)}
  </section>
</BaseLayout>

<style>
  .post-list {
    max-width: var(--measure-md);
    margin: 0 auto;
    padding: var(--space-14) var(--space-36) var(--space-56);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
</style>
