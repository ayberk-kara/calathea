---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TagFilter from '../../../components/TagFilter.astro';
import PostRow from '../../../components/PostRow.astro';
import { LOCALES, getSlug, localize, localizeAll } from '../../../lib/i18n';
import { getUI } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getUI(locale);

const posts = localizeAll(await getCollection('posts'), locale).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const projects = await getCollection('projects');
const projectTitles = new Map<string, string>();
for (const post of posts) {
  if (post.data.project) {
    const project = localize(projects, getSlug(post.data.project.id), locale);
    if (project) projectTitles.set(post.id, project.data.title);
  }
}
---

<BaseLayout
  title="Blog — AK"
  description="Notes from the kernel mines — deep dives, dev notes, and release logs, cross-linked to the projects they came out of."
  active="blog"
>
  <PageHeader color="accent-3" measure="md" eyebrow={t.blogPage.eyebrow} title={t.blogPage.title} subtitle={t.blogPage.subtitle} />

  <TagFilter
    items={posts.map((p) => ({ tags: p.data.tags }))}
    activeColor="accent-3"
    label={t.filter.tagLabel}
    noun={t.filter.postsNoun}
    allLabel={t.filter.all}
    showingTemplate={t.filter.showing('{visible}', '{total}', '{noun}')}
  />

  <section class="post-list">
    {posts.map((post) => <PostRow post={post} projectTitle={projectTitles.get(post.id)} />)}
  </section>
</BaseLayout>

<style>
  .post-list {
    max-width: var(--measure-md);
    margin: 0 auto;
    padding: var(--space-14) var(--space-36) var(--space-56);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
</style>
