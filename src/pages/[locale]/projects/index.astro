---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { LOCALES, localizeAll } from '../../../lib/i18n';
import { getUI } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getUI(locale);

const projects = localizeAll(await getCollection('projects'), locale).sort((a, b) =>
  a.data.index.localeCompare(b.data.index),
);
---

<BaseLayout
  title="Projects — AK"
  description="Inference systems, GPU kernels, search infrastructure, and the small tools that make them usable."
  active="projects"
>
  <PageHeader color="rust" eyebrow={t.projectsPage.eyebrow} title={t.projectsPage.title} subtitle={t.projectsPage.subtitle} />

  <TagFilter
    items={projects.map((p) => ({ tags: p.data.tags }))}
    activeColor="ink"
    label={t.filter.filterLabel}
    noun={t.filter.projectsNoun}
    allLabel={t.filter.all}
    showingTemplate={t.filter.showing('{visible}', '{total}', '{noun}')}
  />

  <section class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

<style>
  .projects-grid {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-14) var(--space-36) var(--space-56);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }

  @media (max-width: 1080px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 880px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
