---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.index.localeCompare(b.data.index));
---

<BaseLayout
  title="Projects — AK"
  description="Inference systems, GPU kernels, search infrastructure, and the small tools that make them usable."
  active="projects"
>
  <PageHeader
    color="rust"
    eyebrow="THE WHOLE SHELF"
    title="PROJECTS"
    subtitle="Inference systems, GPU kernels, search infrastructure, and the small tools that make them usable. Filter by what they are built on."
  />

  <section class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

<style>
  .projects-grid {
    max-width: var(--measure-xl);
    margin: 0 auto;
    padding: var(--space-14) var(--space-36) var(--space-56);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }

  @media (max-width: 1080px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 880px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
